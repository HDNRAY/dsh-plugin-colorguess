{
  "name": "colorguess-dsh-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "ColorGuess DSH plugin: session-header action that opens the game in a drawer iframe (game hosted on GitHub Pages).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src"
  ],
  "devDependencies": {
    "esbuild": "^0.21.5"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "@deepseek-ai/cordis": "*"
  },
  "license": "MIT"
}
